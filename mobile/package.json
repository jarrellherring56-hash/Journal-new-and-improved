{
  "name": "journal-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS wrapper (Capacitor) for the Journal web app.",
  "scripts": {
    "copy-web": "node copy-web.js",
    "add-ios": "npm run copy-web && npx cap add ios",
    "sync": "npm run copy-web && npx cap sync ios",
    "open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
